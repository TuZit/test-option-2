# Copy to `.env.local` to run the frontend against the real backend API.
#
# When VITE_API_BASE_URL is set, src/services/index.js uses the HTTP task
# service instead of the in-memory mock. VITE_USER_ID is sent as the
# `X-User-Id` development-auth header.
#
# Start the backend first: cd ../be && pnpm start

# Option A (recommended for `pnpm dev`): same-origin path proxied by Vite
# (vite.config.js) to http://127.0.0.1:3003 — no CORS involved at all.
VITE_API_BASE_URL=/api
VITE_USER_ID=user-a

# Option B: call the backend directly. The backend's CORS allowlist accepts
# localhost / 127.0.0.1 on any port by default, so this works in the browser.
# VITE_API_BASE_URL=http://127.0.0.1:3003

# If the backend runs elsewhere, also update the Vite proxy target
# (`TASK_API_URL` env var) or add the frontend origin to the backend's
# CORS_ORIGINS allowlist.
