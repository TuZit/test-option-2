# Copy to `.env.local` to run the frontend against the real backend API.
#
# When VITE_API_BASE_URL is set, src/services/index.js uses the HTTP task
# service instead of the in-memory mock. VITE_USER_ID is sent as the
# `X-User-Id` development-auth header.
#
# Start the backend first: cd ../be && pnpm start

# Recommended for `pnpm dev`: same-origin path proxied by Vite (vite.config.js)
# to http://127.0.0.1:3003, so the browser never hits CORS.
# VITE_API_BASE_URL=/api
VITE_USER_ID=user-a

# Absolute URL alternative (skips the proxy, so the browser needs CORS):
VITE_API_BASE_URL=http://127.0.0.1:3003
